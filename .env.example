# Local default: no key, no account, no paid service required.
QUERYCRAFT_PROVIDER=ollama
QUERYCRAFT_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
# Optional remote Ollama proxy authentication; keep unset locally.
# OLLAMA_API_KEY=

# Optional hosted provider. Configure in the hosting secret manager; never commit a real key.
# QUERYCRAFT_PROVIDER=openai
# OPENAI_MODEL=
# OPENAI_API_KEY=

# Deployment hostname and exact HTTPS origin, with no wildcard.
# QUERYCRAFT_ALLOWED_HOSTS=querycraft.example.com
# QUERYCRAFT_ALLOWED_ORIGINS=https://querycraft.example.com
# QUERYCRAFT_ACCESS_USER=demo
# QUERYCRAFT_ACCESS_PASSWORD=
# QUERYCRAFT_SECURE_COOKIE=1
# QUERYCRAFT_MAX_WORKSPACES=250
